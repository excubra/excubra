# /etc/excubra/server.env — the one configuration file of an EX0 server (ADR-0009).
# Everything else lives in the database and is edited in the console.

# Where databases and the internal CA live (backed up by `excubra server backup`).
EXCUBRA_DATA_DIR=/var/lib/excubra

# Public mTLS listener the boxes connect to.
EXCUBRA_INGEST_LISTEN=:443
# host[:port] the boxes dial — goes into enrollment keys and the ingest certificate.
EXCUBRA_INGEST_PUBLIC_HOST=ingest.ex0.example.com

# Console and status API: ONLY on the NetBird interface address of this host.
# The server refuses wildcards. Find the address with `ip -4 addr show wt0`.
EXCUBRA_OVERLAY_LISTEN=100.64.0.10:8080
# off (plain HTTP inside the overlay) or internal (certificate from the internal CA)
EXCUBRA_OVERLAY_TLS=off
# Base URL used in webhook links (defaults to http(s)://<overlay listen>)
# EXCUBRA_CONSOLE_URL=http://ex0.viico.internal:8080

# Where update metadata points (server never serves binaries)
# EXCUBRA_UPDATE_BASE_URL=https://github.com/excubra/excubra/releases/download

EXCUBRA_LOG_LEVEL=info
EXCUBRA_LOG_FORMAT=text
