# build output
/bin/
/dist/
*.test
*.out
coverage.*

# local state and secrets — never commit
/var/
/state/
*.key
*.pem
!fixtures/**/*.pem
.env
.env.*

# editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# console build — `make web` produces webdist/, go build embeds it
/web/node_modules/
/internal/server/console/webdist/*
!/internal/server/console/webdist/unbuilt.html
